{
  "id": "generic-meter",
  "name": "Generic RS-485 Energy Meter (Eastron-style float map)",
  "register_type": "input",
  "word_order": "high_first",
  "registers": [
    { "metric": "ac.voltage",       "address": 0,  "type": "float32", "unit": "V",   "scale": 1 },
    { "metric": "ac.current",       "address": 6,  "type": "float32", "unit": "A",   "scale": 1 },
    { "metric": "ac.power",         "address": 12, "type": "float32", "unit": "W",   "scale": 1 },
    { "metric": "ac.frequency",     "address": 70, "type": "float32", "unit": "Hz",  "scale": 1 },
    { "metric": "ac.energy.import", "address": 72, "type": "float32", "unit": "kWh", "scale": 1 },
    { "metric": "ac.energy.export", "address": 74, "type": "float32", "unit": "kWh", "scale": 1 }
  ]
}
