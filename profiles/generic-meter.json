{
  "id": "generic-meter",
  "name": "Single-phase AC Energy Meter (RS-485, 0x0200 float map)",
  "register_type": "input",
  "word_order": "high_first",
  "registers": [
    { "metric": "ac.voltage",        "address": 512, "type": "float32", "unit": "V",   "scale": 1 },
    { "metric": "ac.frequency",      "address": 514, "type": "float32", "unit": "Hz",  "scale": 1 },
    { "metric": "ac.current",        "address": 516, "type": "float32", "unit": "A",   "scale": 1 },
    { "metric": "ac.power",          "address": 522, "type": "float32", "unit": "W",   "scale": 1 },
    { "metric": "ac.power.apparent", "address": 528, "type": "float32", "unit": "VA",  "scale": 1 },
    { "metric": "ac.power.reactive", "address": 534, "type": "float32", "unit": "var", "scale": 1 },
    { "metric": "ac.power_factor",   "address": 540, "type": "float32", "unit": "",    "scale": 1 },
    { "metric": "ac.energy.import",  "address": 546, "type": "float32", "unit": "kWh", "scale": 1 },
    { "metric": "ac.energy.export",  "address": 552, "type": "float32", "unit": "kWh", "scale": 1 },
    { "metric": "ac.energy.total",   "address": 556, "type": "float32", "unit": "kWh", "scale": 1 }
  ]
}
