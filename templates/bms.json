{
  "id": "template-bms",
  "name": "TEMPLATE: battery management system — set addresses/comms, rename id, move to profiles/",
  "category": "bms",
  "schema_version": 2,
  "register_type": "holding",
  "word_order": "high_first",
  "registers": [
    { "metric": "battery.voltage",            "address": 0,  "type": "float32", "unit": "V",  "scale": 1 },
    { "metric": "battery.current",            "address": 2,  "type": "float32", "unit": "A",  "scale": 1 },
    { "metric": "battery.power",              "address": 4,  "type": "float32", "unit": "W",  "scale": 1 },
    { "metric": "battery.soc",                "address": 6,  "type": "float32", "unit": "%",  "scale": 1 },
    { "metric": "battery.soh",                "address": 8,  "type": "float32", "unit": "%",  "scale": 1 },
    { "metric": "battery.capacity.remaining", "address": 10, "type": "float32", "unit": "Ah", "scale": 1 },
    { "metric": "battery.capacity.full",      "address": 12, "type": "float32", "unit": "Ah", "scale": 1 },
    { "metric": "battery.cycles",             "address": 14, "type": "float32", "unit": "",   "scale": 1 },
    { "metric": "cell.voltage.min",           "address": 16, "type": "float32", "unit": "V",  "scale": 1 },
    { "metric": "cell.voltage.max",           "address": 18, "type": "float32", "unit": "V",  "scale": 1 },
    { "metric": "cell.voltage.delta",         "address": 20, "type": "float32", "unit": "V",  "scale": 1 },
    { "metric": "battery.temperature",        "address": 22, "type": "float32", "unit": "°C", "scale": 1 },
    { "metric": "cell.temperature.min",       "address": 24, "type": "float32", "unit": "°C", "scale": 1 },
    { "metric": "cell.temperature.max",       "address": 26, "type": "float32", "unit": "°C", "scale": 1 },

    { "metric": "cell.voltage", "address": 28, "type": "array", "element": "uint16",
      "count": 16, "stride": 1, "unit": "V", "scale": 0.001 },

    { "metric": "charge.mosfet",    "address": 44, "type": "bool" },
    { "metric": "discharge.mosfet", "address": 45, "type": "bool" },
    { "metric": "balancing",        "address": 46, "type": "bool" },

    { "prefix": "protection", "address": 47, "type": "bitflags",
      "flags": { "0": "under_voltage", "1": "over_voltage", "2": "over_current_charge",
                 "3": "over_current_discharge", "4": "under_temperature", "5": "over_temperature",
                 "6": "short_circuit" } }
  ]
}
