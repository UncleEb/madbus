{
  "id": "template-charge-controller",
  "name": "TEMPLATE: solar charge controller — set addresses/comms, rename id, move to profiles/",
  "category": "charge_controller",
  "schema_version": 2,
  "register_type": "holding",
  "word_order": "high_first",
  "registers": [
    { "metric": "pv.voltage",         "address": 0,  "type": "float32", "unit": "V",   "scale": 1 },
    { "metric": "pv.current",         "address": 2,  "type": "float32", "unit": "A",   "scale": 1 },
    { "metric": "pv.power",           "address": 4,  "type": "float32", "unit": "W",   "scale": 1 },
    { "metric": "battery.voltage",    "address": 6,  "type": "float32", "unit": "V",   "scale": 1 },
    { "metric": "battery.current",    "address": 8,  "type": "float32", "unit": "A",   "scale": 1 },
    { "metric": "battery.power",      "address": 10, "type": "float32", "unit": "W",   "scale": 1 },
    { "metric": "pv.yield.today",     "address": 12, "type": "float32", "unit": "kWh", "scale": 1 },
    { "metric": "pv.yield.total",     "address": 14, "type": "float32", "unit": "kWh", "scale": 1 },
    { "metric": "device.temperature", "address": 16, "type": "float32", "unit": "°C",  "scale": 1 },
    { "metric": "charge.state", "address": 18, "type": "enum",
      "values": { "0": "off", "1": "bulk", "2": "absorption", "3": "float", "4": "equalize", "5": "fault" } },
    { "metric": "error.code", "address": 19, "type": "enum",
      "values": { "0": "none", "1": "over_voltage", "2": "over_temperature", "3": "internal_fault" } }
  ]
}
